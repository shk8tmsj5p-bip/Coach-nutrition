# Copier vers .env.local — ne jamais committer les vraies clés

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Accès foyer (pas d’identifiant à l’écran) ---
# Email interne pour Auth / RLS. Le mot de passe n’est jamais commit.
HOUSEHOLD_EMAIL=foyer@coach-nutrition.app
HOUSEHOLD_PASSWORD=
HOUSEHOLD_SESSION_SECRET=

# --- Alertes accès foyer ---
# Sans nom de domaine : Gmail SMTP (prioritaire). Mot de passe d’application Google,
# pas le mot de passe du compte. Envoie vers HOUSEHOLD_ALERT_EMAILS.
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
HOUSEHOLD_ALERT_EMAILS=alexis@example.com,elodie@example.com
# Optionnel (besoin d’un domaine vérifié) :
# RESEND_API_KEY=
# RESEND_FROM=Coach Nutrition <alertes@votredomaine.fr>

# --- Gemini (Pro = Gem Chef, Flash = vision / OCR / coach) ---
# Les versions sont lues dynamiquement (GET /v1beta/models).
# Ces lignes sont optionnelles : un id précis est essayé en premier s'il est encore servi.
GEMINI_API_KEY=
GEMINI_MODEL_PRO=
GEMINI_MODEL_FLASH=

# --- Strava ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Webhook iOS Shortcut → Apple Santé (pas + séances) ---
# POST {origin}/api/webhooks/health  (?profile_id=alexis|elodie)
# Alias : /api/health-webhook
# Header x-health-webhook-secret, query ?secret=, ou champ JSON "secret"
HEALTH_WEBHOOK_SECRET=
